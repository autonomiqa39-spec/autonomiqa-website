# ─────────────────────────────────────────────────────────────────────────────
# Autonomiqa Contact Form — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your_google_sheet_id_here

# Optional: comma-separated list of frontend origins allowed to call the API.
# Update this when the website is deployed to a real domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://autonomiqa.co

# Paste the ENTIRE content of your service account JSON key file as a
# single-line JSON string (keep all the \n escaped properly).
# Easiest way: python3 -c "import json,sys; print(json.dumps(json.load(open('key.json'))))"
SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Optional: set this in the website app so ContactForm.jsx can read the API URL.
# VITE_CONTACT_FORM_API_URL=http://localhost:8000/submit-form

# SMTP Alert configurations:
SYSTEM_SENDER_EMAIL=your-sender-email@gmail.com
SYSTEM_ALERT_RECEIVER=your-receiver-email@gmail.com
SYSTEM_SMTP_PASSWORD=your-smtp-app-password
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_PORT=587
