[Unit]
Description=Autonomiqa FastAPI Backend Service
After=network.target

[Service]
User=root
WorkingDirectory=/home/YOUR_VM_USERNAME/autonomiqa-website
ExecStart=/home/YOUR_VM_USERNAME/autonomiqa-website/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
