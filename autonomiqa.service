[Unit]
Description=Autonomiqa FastAPI Backend Service
After=network.target

[Service]
User=root
WorkingDirectory=/home/YOUR_VM_USERNAME/autonomiqa-website
ExecStart=/home/YOUR_VM_USERNAME/autonomiqa-website/venv/bin/uvicorn main:app --host 0.0.0.0 --port 80
Restart=always

[Install]
WantedBy=multi-user.target
